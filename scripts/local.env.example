# Copy this file to scripts/local.env and edit it for your laptop.
# scripts/local.env is ignored by git.

# Native Ubuntu usually works best with autovideosink.
# WSL/X11 users should use ximagesink so the H264 preview window can be moved.
VIDEO_SINK=autovideosink
# VIDEO_SINK=ximagesink

# Optional network overrides.
# JETSON_USER=puzzlebot
# JETSON_HOST=10.10.0.100
# REMOTE_WS=/home/puzzlebot/ros2_ws

# Optional stream overrides.
# STREAM=h264
# H264_PORT=5000
# H264_BITRATE=2000000
